# Vercel KV credentials — auto-filled when you connect a KV store to this
# project in the Vercel dashboard (Storage tab -> Create Database -> KV).
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Your own secret for the /admin dashboard (creating new profiles).
# Set this in Vercel Project Settings -> Environment Variables.
# Pick any long random string.
ADMIN_SECRET=change-me-to-a-long-random-string
